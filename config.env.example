# Public base URL of the deployed AllinOne Worker/site.
# Example: https://tools.example.com
INSPECTOR_ENDPOINT=https://your-allinone-domain.example

# Skip request bodies larger than this many bytes. Default: 256 KiB.
BODY_LIMIT=262144

# Seconds to wait when forwarding one live capture event to Cloudflare.
POST_TIMEOUT=5

# Local proxy listener for the iPhone.
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8445
